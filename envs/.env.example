# Secrets and machine-local settings for the ATSP benchmark.
#
#   cp envs/.env.example envs/.env      # then fill it in
#
# envs/.env is git-ignored and is loaded automatically by every entry point
# (run_eoh_atsp.py, eval_eoh_atsp.py, the shell scripts). Real environment
# variables always win over this file, so you can still override per command:
#
#   OPENAI_API_KEY=sk-other python python_scripts/llm/EoH/run_eoh_atsp.py --task gls
#
# Point somewhere else with ENV_FILE=/path/to/other.env if you keep several.

# ── LLM credentials ───────────────────────────────────────────────────────────
# The default configs use OpenAI's endpoint with gpt-4o-mini.
OPENAI_API_KEY=sk-replace-me

# Only needed if you switch provider with --set llm.api_endpoint=...
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=

# ── Optional machine-local defaults ───────────────────────────────────────────
# These are plain shell variables: reference them explicitly when you want them,
# e.g.  --model "$EOH_MODEL"  or  --set eoh.num_samplers=$EOH_SAMPLERS
EOH_MODEL=gpt-4o-mini
EOH_SAMPLERS=4
EOH_EVALUATORS=4

# TASKS and REPEATS are deliberately NOT set here. Both run_all.sh scripts
# source this file and then read $TASKS, but the two frameworks name their
# tasks differently — EoH's "construct gls aco rnr" against ReEvo's
# "atsp_constructive atsp_gls atsp_aco" — so a value here silently feeds one
# framework the other's task names. Pass them per command instead:
#
#   TASKS="gls" bash scripts/llm/EoH/run_all.sh
#   TASKS="atsp_gls" REPEATS=3 bash scripts/llm/ReEvo/run_all.sh
#
# PYTHON is likewise best left unset: the scripts then pick python3, which is
# what exists on macOS and most Linux distros. Set it only to pin a specific
# interpreter, and make sure that one has the dependencies installed.
# PYTHON=/path/to/venv/bin/python

# Slurm (scripts/llm/EoH/submit_slurm.sh)
PARTITION=cpu
TIME=06:00:00
CPUS=8
MEM=16G
CONDA_ENV=eoh-atsp
