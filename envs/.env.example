# Secrets and machine-local settings for the ATSP benchmark.
#
#   cp envs/.env.example envs/.env      # then fill it in
#
# envs/.env is git-ignored and is loaded automatically by every entry point
# (EoH's run_eoh_atsp.py / eval_eoh_atsp.py, ReEvo's main.py, MCTS-AHD's
# main.py, and the shell scripts). Real environment variables always win over
# this file, so you can still override per command:
#
#   OPENAI_API_KEY=sk-other python python_scripts/llm/EoH/run_eoh_atsp.py --task gls
#
# Point somewhere else with ENV_FILE=/path/to/other.env if you keep several.

# ── LLM credentials ───────────────────────────────────────────────────────────
# The default configs use OpenAI's endpoint with gpt-4o-mini.
OPENAI_API_KEY=sk-replace-me

# Only needed if you switch provider (EoH: --set llm.api_endpoint=...;
# ReEvo / MCTS-AHD: llm_client=litellm llm_client.model=<provider>/<model>).
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
ANTHROPIC_API_KEY=

# ── Optional machine-local defaults ───────────────────────────────────────────
# These are plain shell variables: reference them explicitly when you want them,
# e.g.  --model "$EOH_MODEL"  or  --set eoh.num_samplers=$EOH_SAMPLERS
EOH_MODEL=gpt-4o-mini
EOH_SAMPLERS=4
EOH_EVALUATORS=4

# TASKS, REPEATS and MAX_FE are deliberately NOT set here. All three run_all.sh
# scripts source this file and then read $TASKS, but the frameworks name their
# tasks differently — EoH's "construct gls aco rnr", ReEvo's "atsp_constructive
# atsp_gls atsp_aco", MCTS-AHD's "atsp_constructive atsp_gls atsp_kgls" — so a
# value here silently feeds one framework another's task names. Pass them per
# command instead:
#
#   TASKS="gls" bash scripts/llm/EoH/run_all.sh
#   TASKS="atsp_gls" REPEATS=3 bash scripts/llm/ReEvo/run_all.sh
#   TASKS="atsp_kgls" MAX_FE=200 bash scripts/llm/MCTS-AHD/run_all.sh
#   TASKS="atsp_gls" ITERATIONS=20 bash scripts/llm/MoH/run_all.sh
#
# PYTHON is likewise best left unset: the scripts then pick python3, which is
# what exists on macOS and most Linux distros. Set it only to pin a specific
# interpreter, and make sure that one has the dependencies installed.
# PYTHON=/path/to/venv/bin/python

# ── MoH ───────────────────────────────────────────────────────────────────────
# MoH reads the same OPENAI_API_KEY above and needs nothing else to run. These
# two are the escape hatches for the evaluation subprocesses, which have no
# Hydra context: `solvers/llm/MoH/moh.py` sets them from cfg.data and
# cfg.problem.problem_name, and setting them here overrides that for a manual
# `python problems/<task>/eval.py` invocation.
#
#   ATSP_DATA          which configs/llm/MoH/cfg/data/<name>.yaml to use
#                      (synthetic | tsplib | multisize). Shared with the
#                      MCTS-AHD side, which has its own set of names.
#   ATSP_EVAL_BUDGET   which configs/llm/MoH/cfg/evaluation/<task>.yaml to use
#
# Leave both unset for normal runs — the config decides, and a stale value here
# would silently score one task's heuristics under another task's budget.
# ATSP_DATA=synthetic
# ATSP_EVAL_BUDGET=atsp_gls

# ── MCTS-AHD ──────────────────────────────────────────────────────────────────
# Which instances the search is scored on: "tsplib" (the default: rbg323 and
# rbg403, identical to ReEvo's split) or "synthetic" (data/synthetic, generated
# by `python data/generate_atsp.py --all`, leaving the whole benchmark held out).
# Read by solvers/llm/MCTS-AHD/atsp_utils.py at evaluation time.
# ATSP_TRAIN_SPLIT=tsplib

# Slurm (scripts/llm/*/submit_slurm.sh)
PARTITION=cpu
TIME=06:00:00
CPUS=8
MEM=16G
CONDA_ENV=eoh-atsp
